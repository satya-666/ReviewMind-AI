APP_ENV=development
MODEL_PATH=models/phase3/full/baseline/logistic_regression.joblib
MODEL_MANIFEST_PATH=backend/model_manifest.json
DATABASE_URL=sqlite:///.cache/web/feedback.db
AUTO_CREATE_DB=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_API_URL=
RATE_LIMIT_PER_MINUTE=20
GLOBAL_RATE_LIMIT_PER_MINUTE=120
# Production: APP_ENV=production, AUTO_CREATE_DB=false, HTTPS origins, PostgreSQL URL.
# Docker bundles the approved model at MODEL_PATH=/app/runtime/model.joblib.
# No external model storage or MODEL_ARTIFACT_URL is required.
GEMINI_MODEL=gemini-3.1-flash-lite
# Set GEMINI_API_KEY only in backend secrets. Never in frontend configuration.
# Without a Gemini key, conversation returns an explicit configuration error.
# Keep the Google project on its Free tier; no code setting controls account billing.

# Optional India Shopping provider; backend only. Use a free account without extra credits.
# SERPAPI_API_KEY=

# Public Google OAuth Web client ID; production APIs require Google sign-in.
GOOGLE_CLIENT_ID=
